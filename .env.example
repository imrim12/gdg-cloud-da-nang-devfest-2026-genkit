# Required
NUXT_GEMINI_API_KEY=

# Optional overrides
# NUXT_MODEL=gemini-3.5-flash-lite
# NUXT_LIVE_MODEL=gemini-3.8-live

# Google Cloud (each feature turns on when its variables are set; see scripts/setup.ts)
# NUXT_GCP_PROJECT=
# NUXT_GCP_LOCATION=us-central1
# NUXT_GCP_ENGINE=projects/<p>/locations/<l>/reasoningEngines/<id>
# NUXT_GCP_SHELL_TEMPLATE=
# NUXT_GCP_BROWSER_TEMPLATE=
# NUXT_GCP_SERVICE_ACCOUNT=
# NUXT_GCP_BUCKET=

# Sign in with Google (optional for the MVP)
# NUXT_PUBLIC_AUTH=true
# NUXT_AUTH_SECRET=
# NUXT_AUTH_GOOGLE_CLIENT_ID=
# NUXT_AUTH_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
