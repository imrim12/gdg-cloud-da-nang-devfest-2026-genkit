# Required
NUXT_GEMINI_API_KEY=

# Optional overrides
# NUXT_MODEL=gemini-3.5-flash          # default chat model (the picker lists all Gemini models)
# NUXT_TITLE_MODEL=gemini-3.5-flash-lite
# NUXT_LIVE_MODEL=gemini-3.8-live

# Google Cloud (each feature turns on when its variables are set; see README)
# NUXT_GCP_PROJECT=
# NUXT_GCP_FIRESTORE=(default)          # chat history in Firestore; empty = in memory
# NUXT_GCP_BUCKET=                      # uploads and saved files
# NUXT_GCP_LOCATION=us-central1         # Agent Platform region
# NUXT_GCP_ENGINE=projects/<p>/locations/<l>/reasoningEngines/<id>
# NUXT_GCP_SHELL_TEMPLATE=
# NUXT_GCP_BROWSER_TEMPLATE=
# NUXT_GCP_SERVICE_ACCOUNT=

# Firestore emulator (npx firebase-tools emulators:start --only firestore)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Sign in with Google (optional)
# NUXT_PUBLIC_AUTH=true
# NUXT_AUTH_SECRET=
# NUXT_AUTH_GOOGLE_CLIENT_ID=
# NUXT_AUTH_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
